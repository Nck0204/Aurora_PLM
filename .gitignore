# Ambiente virtuale Python
.venv/
venv/
env/

# File compilati e cache di Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Configurazione locale: contiene segreti, non deve mai finire in git.
# In repository resta solo .env.example.
#
# Le altre due righe sono i file che nascono quando la pagina
# «Configurazione posta» salva i parametri (D-081): la copia di sicurezza del
# file di prima e il file a meta' scrittura. Contengono gli stessi segreti.
.env
.env.precedente
.env.tmp

# Archivio dei file caricati: sono dati aziendali, non codice.
# La cartella resta in git (grazie a .gitkeep), il contenuto no.
storage/*
!storage/.gitkeep

# Copie di sicurezza (sessione 12). Dentro ci sono il salvataggio del
# database, l'archivio dei file e una copia del .env: sono i dati dell'azienda
# e i suoi segreti, non codice. In produzione questa cartella sta comunque su
# un altro disco (BACKUP_PATH); qui si ignora il caso in cui qualcuno la lasci
# dentro il progetto durante una prova.
backup/

# Registri applicativi
logs/
*.log

# File di editor e di sistema
.vscode/
.idea/
Thumbs.db
desktop.ini

# Configurazione locale degli strumenti di sviluppo (avvio del server nella
# finestra di anteprima). Non serve a chi usa Aurora e cambia da computer a
# computer.
.claude/
