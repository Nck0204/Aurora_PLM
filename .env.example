# ============================================================================
#  Aurora - modello del file di configurazione
# ----------------------------------------------------------------------------
#  Copiare questo file con il nome ".env" nella stessa cartella e adattare i
#  valori. Il file ".env" NON viene versionato in git perche' contiene segreti.
#
#  Regole di scrittura:
#    - una variabile per riga, nella forma NOME=valore
#    - niente spazi attorno al segno "="
#    - niente virgolette, a meno che non facciano parte del valore
#    - le righe che iniziano con # sono commenti
# ============================================================================


# --- Database ---------------------------------------------------------------
# Stringa di connessione a PostgreSQL, nella forma:
#   postgresql+psycopg://UTENTE:PASSWORD@INDIRIZZO:PORTA/NOMEDATABASE
# "postgresql+psycopg" indica a SQLAlchemy di usare il driver psycopg 3.
# Se la password contiene caratteri speciali (@ : / #) vanno codificati
# in percentuale: ad esempio "p@ss" diventa "p%40ss".
DATABASE_URL=postgresql+psycopg://aurora_app:CAMBIAMI@localhost:5432/aurora


# --- Archivio dei file ------------------------------------------------------
# Cartella in cui Aurora deposita i documenti caricati (disegni, schemi,
# distinte base, allegati). Puo' essere un percorso assoluto oppure relativo
# alla radice del progetto. In produzione conviene un disco dedicato,
# ad esempio D:\AuroraStorage, incluso nei backup del server.
STORAGE_PATH=storage


# --- Sicurezza --------------------------------------------------------------
# Chiave segreta usata per firmare i cookie di sessione.
# DEVE essere diversa in produzione e non va mai condivisa.
# Per generarne una nuova:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=chiave-di-sviluppo-da-sostituire-in-produzione


# --- Applicazione -----------------------------------------------------------
# Nome mostrato nell'interfaccia e nel titolo delle pagine.
APP_NAME=Aurora

# Quantita' di dettaglio nei registri, dal piu' loquace al piu' silenzioso:
#   DEBUG, INFO, WARNING, ERROR, CRITICAL
# In sviluppo conviene DEBUG, in produzione INFO.
LOG_LEVEL=INFO


# --- Posta elettronica ------------------------------------------------------
# Come Aurora spedisce le notifiche. Due soli valori ammessi:
#   locale -> i messaggi non partono davvero: vengono scritti come file .eml
#             nella cartella MAIL_LOCAL_PATH. Utile in sviluppo e collaudo.
#   graph  -> i messaggi partono davvero attraverso Microsoft Graph
#             (Microsoft 365). Da usare in produzione.
MAIL_PROVIDER=locale

# Cartella in cui finiscono i messaggi quando MAIL_PROVIDER=locale.
# Viene ignorata quando MAIL_PROVIDER=graph.
MAIL_LOCAL_PATH=storage/posta
