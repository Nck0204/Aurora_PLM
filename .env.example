# ============================================================================
#  Aurora - modello del file di configurazione
# ----------------------------------------------------------------------------
#  Copiare questo file con il nome ".env" nella stessa cartella e adattare i
#  valori. Il file ".env" NON viene versionato in git perche' contiene segreti.
#
#  Regole di scrittura:
#    - una variabile per riga, nella forma NOME=valore
#    - niente spazi attorno al segno "="
#    - niente virgolette, a meno che non facciano parte del valore
#    - le righe che iniziano con # sono commenti
# ============================================================================


# --- Database ---------------------------------------------------------------
# Stringa di connessione a PostgreSQL, nella forma:
#   postgresql+psycopg://UTENTE:PASSWORD@INDIRIZZO:PORTA/NOMEDATABASE
# "postgresql+psycopg" indica a SQLAlchemy di usare il driver psycopg 3.
# Se la password contiene caratteri speciali (@ : / #) vanno codificati
# in percentuale: ad esempio "p@ss" diventa "p%40ss".
DATABASE_URL=postgresql+psycopg://aurora_app:CAMBIAMI@localhost:5432/aurora


# --- Archivio dei file ------------------------------------------------------
# Cartella in cui Aurora deposita i documenti caricati (disegni, schemi,
# distinte base, allegati). Puo' essere un percorso assoluto oppure relativo
# alla radice del progetto. In produzione conviene un disco dedicato,
# ad esempio D:\AuroraStorage, incluso nei backup del server.
STORAGE_PATH=storage


# --- Sicurezza --------------------------------------------------------------
# Chiave segreta usata per firmare i cookie di sessione.
# DEVE essere diversa in produzione e non va mai condivisa.
# Per generarne una nuova:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=chiave-di-sviluppo-da-sostituire-in-produzione


# --- Applicazione -----------------------------------------------------------
# Nome mostrato nell'interfaccia e nel titolo delle pagine.
APP_NAME=Aurora

# Quantita' di dettaglio nei registri, dal piu' loquace al piu' silenzioso:
#   DEBUG, INFO, WARNING, ERROR, CRITICAL
# In sviluppo conviene DEBUG, in produzione INFO.
LOG_LEVEL=INFO


# --- Posta elettronica ------------------------------------------------------
# Da dove Aurora legge i messaggi da archiviare, e come spedisce le notifiche.
# Due soli valori ammessi:
#   locale -> Aurora legge i messaggi da file .eml dentro MAIL_LOCAL_PATH, e
#             i messaggi che spedisce li scrive li' invece di farli partire.
#             E' quello che si usa in sviluppo e in collaudo.
#   graph  -> Aurora si collega alla casella aziendale attraverso Microsoft
#             Graph (Microsoft 365) e legge i messaggi non letti della posta
#             in arrivo. Servono i quattro parametri piu' sotto.
MAIL_PROVIDER=locale

# Cartella della posta, usata quando MAIL_PROVIDER=locale.
#
# Aurora legge i file .eml che trova qui dentro e, dopo averli archiviati, li
# sposta in due sottocartelle che crea da sola:
#
#   MAIL_LOCAL_PATH/               i messaggi ancora da leggere
#   MAIL_LOCAL_PATH/elaborate/     quelli archiviati e attribuiti
#   MAIL_LOCAL_PATH/quarantena/    quelli che aspettano una persona
#
# I messaggi di prova si generano con 'python scripts/genera_email_prova.py'.
# Viene ignorata quando MAIL_PROVIDER=graph.
MAIL_LOCAL_PATH=storage/posta

# --- La casella aziendale (serve solo con MAIL_PROVIDER=graph) --------------
# I quattro parametri con cui Aurora si collega alla casella di Microsoft 365.
# Li fornisce l'ufficio informatico dopo aver registrato l'applicazione: la
# richiesta gia' pronta da mandargli e' in docs/RICHIESTA_IT.md.
#
# NON E' NECESSARIO SCRIVERLI QUI A MANO. La pagina «Configurazione posta»
# (/posta/configurazione, riservata al creatore) li salva in questo file da
# sola, e accanto a ogni campo ha un pulsante VERIFICA che prova il
# collegamento e risponde subito che cosa non va. Vedi D-081.

# Identificativo dell'organizzazione Microsoft 365. Nel portale Microsoft e'
# la voce "ID directory (tenant)". Va bene anche il dominio dell'azienda.
MAIL_TENANT_ID=

# Identificativo della registrazione applicativa creata per Aurora. Nel
# portale e' la voce "ID applicazione (client)".
MAIL_CLIENT_ID=

# Segreto della registrazione applicativa. E' il valore della colonna
# "Valore", non quello della colonna "ID segreto", e si puo' leggere solo nel
# momento in cui viene creato.
#
# E' UNA PASSWORD: chi puo' leggere questo file puo' leggere la casella.
MAIL_CLIENT_SECRET=

# Indirizzo della casella da cui Aurora legge i messaggi. Deve essere una
# casella vera, non un alias e non un gruppo.
MAIL_MAILBOX_ADDRESS=

# Data di scadenza del segreto, scritta con l'anno davanti (2027-03-15).
# Quando il segreto scade, la posta smette di arrivare e non c'e' nessun
# messaggio di errore che lo dica in anticipo: per questo Aurora lo segnala
# nella diagnostica a partire da trenta giorni prima, con evidenza crescente.
# Lasciandola vuota, la scadenza arrivera' senza preavviso.
MAIL_SECRET_EXPIRES_ON=

# Ogni quanti minuti Aurora va a vedere se e' arrivata posta nuova. Sotto il
# minuto non si scende. Un controllo che dura piu' dell'intervallo non ne fa
# partire un secondo: c'e' un blocco che lo impedisce.
MAIL_POLL_MINUTES=5

# Controllo periodico acceso. Con false la posta si legge soltanto premendo
# "Controlla adesso" nella pagina della posta. Ha effetto al riavvio.
# Il controllo periodico non parte comunque con MAIL_PROVIDER=locale: la
# cartella dei file .eml non si riempie da sola.
MAIL_SCHEDULER_ENABLED=true

# File in cui Aurora tiene il segno di dove era arrivata a leggere la casella.
# Non e' configurazione: e' un segnalibro, si ricostruisce da solo e
# cancellarlo costa al massimo una rilettura della posta in arrivo (D-082).
MAIL_GRAPH_STATE_PATH=storage/posta_graph.json



# --- Accesso e sessioni -----------------------------------------------------
# Attributo "Secure" sui cookie: dice al browser di rimandarli solo su
# connessione cifrata (https).
#   false -> sviluppo, dove si lavora su http://localhost. Con true il browser
#            non rimanderebbe mai il cookie e non si riuscirebbe a entrare.
#   true  -> produzione, dove Aurora sta dietro a https.
COOKIE_SECURE=false

# Durata di una sessione normale, in ore. Il cookie muore comunque alla
# chiusura del browser: questo e' il limite che vale dalla parte del server.
SESSION_HOURS=12

# Durata, in giorni, della sessione lunga emessa dalla casella "Ricordami".
REMEMBER_ME_DAYS=30

# Blocco dei tentativi di accesso: dopo LOGIN_MAX_ATTEMPTS tentativi falliti
# sullo stesso nome utente nell'arco di LOGIN_WINDOW_MINUTES minuti, quel nome
# utente viene rifiutato finche' la finestra non si e' svuotata.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Prodotti ---------------------------------------------------------------
# File che dice come si scompone il codice parlante di un prodotto
# (per esempio RMS1100-24-110SW). E' un file TOML: dentro ci sono
# l'espressione regolare con i gruppi nominati e il nome in italiano di
# ciascun gruppo. La regola di scomposizione non e' ancora stata confermata
# dall'azienda: quando lo sara', si cambia quel file e si riavvia il server,
# senza toccare il programma.
PRODUCT_CODE_CONFIG=config/codice_prodotto.toml

# Quante righe per pagina negli elenchi lunghi (prodotti, progetti).
PAGE_SIZE=25


# --- Documenti --------------------------------------------------------------
# File che elenca i tipi di documento proponibili quando si carica (schema
# elettrico, PCB, firmware, certificato...). E' un file TOML con una voce sola,
# "tipi", che contiene l'elenco nell'ordine in cui deve comparire nel menu.
# L'elenco lo cambia l'azienda: si modifica quel file e si riavvia il server.
# Se il file manca o e' scritto male Aurora parte lo stesso e usa l'elenco di
# ripiego scritto nel programma.
DOCUMENT_TYPES_CONFIG=config/tipi_documento.toml

# Dimensione massima di un file caricato, in megabyte. 2048 = 2 GB.
# Il limite viene verificato mentre il file arriva, non dopo: un file piu'
# grande viene rifiutato senza essere depositato nell'archivio.
MAX_UPLOAD_MB=2048
